{
  "expo": {
    "name": "TakeItEsee",
    "slug": "takeitesee",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "takeitesee",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/official-takeitesee-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your TakeItEsee profile or cover.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uvmart.takeitesee",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.uvmart.takeitesee",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/official-takeitesee-logo.png",
        "backgroundColor": "#F8F7FF"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "aee79da4-1e18-4cdb-b5bd-421180d0decd"
      }
    },
    "owner": "uvmart-takeitesee",
    "icon": "./assets/official-takeitesee-logo.png"
  }
}
