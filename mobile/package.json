{
  "name": "takeitesee-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test:contract": "node --test tests/*.test.mjs",
    "type-check": "tsc --noEmit",
    "eas:whoami": "npx eas-cli@latest whoami",
    "eas:project:info": "npx eas-cli@latest project:info",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "build:ios:production": "npx eas-cli@latest build --platform ios --profile production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.10",
    "expo-constants": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
