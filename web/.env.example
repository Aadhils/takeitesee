# Example environment variables (placeholders only)
# Production mode is enabled automatically once NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are both set.
# Set NEXT_PUBLIC_TAKEITSEE_BACKEND_MODE=development to force the local development fallback even when Supabase is configured.
NEXT_PUBLIC_TAKEITSEE_BACKEND_MODE=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Auth sessions are verified server-side from the Supabase session cookie (see middleware.ts).

# Do not store real secrets in this file
